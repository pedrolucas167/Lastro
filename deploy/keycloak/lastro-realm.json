{
  "realm": "lastro",
  "enabled": true,
  "displayName": "Lastro",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "lastro-service",
        "description": "Chamadas de servico (M2M) a API do Lastro"
      },
      {
        "name": "lastro-operator",
        "description": "Operacao da API do Lastro por pessoas"
      },
      {
        "name": "lastro-holder",
        "description": "Titular de conta (cliente) na API do Lastro"
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "lastro-service",
      "roles": ["lastro-service"]
    },
    {
      "client": "lastro-operator",
      "roles": ["lastro-operator"]
    },
    {
      "client": "lastro-holder",
      "roles": ["lastro-holder"]
    }
  ],
  "clients": [
    {
      "clientId": "lastro-service",
      "name": "Lastro - service account (M2M)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "lastro-service-secret",
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "lastro-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "lastro-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lastro-operator",
      "name": "Lastro - operador (somente desenvolvimento)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "lastro-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "lastro-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lastro-holder",
      "name": "Lastro - titular de conta (somente desenvolvimento)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["http://localhost:8080"],
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "lastro-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "lastro-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-lastro-service",
      "enabled": true,
      "serviceAccountClientId": "lastro-service",
      "realmRoles": ["lastro-service"]
    },
    {
      "username": "operador",
      "enabled": true,
      "email": "operador@lastro.local",
      "emailVerified": true,
      "firstName": "Operador",
      "lastName": "Lastro",
      "credentials": [
        {
          "type": "password",
          "value": "operador",
          "temporary": false
        }
      ],
      "realmRoles": ["lastro-operator"]
    },
    {
      "username": "cliente",
      "enabled": true,
      "email": "cliente@lastro.local",
      "emailVerified": true,
      "firstName": "Cliente",
      "lastName": "Lastro",
      "credentials": [
        {
          "type": "password",
          "value": "cliente",
          "temporary": false
        }
      ],
      "realmRoles": ["lastro-holder"]
    }
  ]
}
